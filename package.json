{
  "name": "report-serv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev": "npm start",
    "build": "ng build",
    "start:api": "node --env-file-if-exists=.env server/index.mjs",
    "start:web": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.cjs --poll 1000",
    "start:prod": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "test:s3": "node --env-file-if-exists=.env --test integration/s3.test.mjs",
    "s3:up": "node scripts/setup-local-s3.mjs && docker compose up -d --wait s3 && node --env-file=.env scripts/init-s3.mjs",
    "s3:down": "docker compose down",
    "docker:up": "node scripts/docker-up.mjs",
    "docker:build": "node scripts/build-docker.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "@ant-design/icons-angular": "22.1.1",
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/lib-storage": "3.1169.0",
    "@fontsource/inter": "5.3.0",
    "exceljs": "4.4.0",
    "ng-zorro-antd": "22.2.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@playwright/test": "1.65.1",
    "typescript": "6.0.3"
  }
}

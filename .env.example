# Local credentials/config are generated by npm run infra:up.
# This file documents keys only; do not copy placeholder credentials to production.
POSTGRES_USER=reports
POSTGRES_DB=reports
POSTGRES_PASSWORD=
# Generated local URLs contain a random password, never commit them.
DATABASE_URL=
DOCKER_DATABASE_URL=
DATABASE_SCHEMA=public
# DATABASE_URL is used by the app directly. DOCKER_DATABASE_URL is used only by
# Compose, where the local database host is postgres instead of 127.0.0.1.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=reports
S3_FORCE_PATH_STYLE=true
S3_PREFIX=reports/
S3_PART_SIZE_MIB=8
S3_UPLOAD_CONCURRENCY=2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# For AWS, omit S3_ENDPOINT, set S3_FORCE_PATH_STYLE=false and use the AWS
# credential provider chain (for example a workload role), or explicit S3 keys.
